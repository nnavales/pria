# Pria btop theme
# Neutral UI; visualizations use the Pria palette and semantic capacity scales.

# Main
theme[main_bg]="#212527"
theme[main_fg]="#D3D9DA"
theme[title]="#D3D9DA"
theme[hi_fg]="#ACEAFE"

# Selection and secondary text
theme[selected_bg]="#394B5B"
theme[selected_fg]="#D3D9DA"
theme[inactive_fg]="#464D4F"
theme[graph_text]="#8A9698"
theme[proc_misc]="#34DACA"
theme[meter_bg]="#2A2F32"

# Structure
theme[cpu_box]="#464D4F"
theme[mem_box]="#464D4F"
theme[net_box]="#464D4F"
theme[proc_box]="#464D4F"
theme[div_line]="#2A2F32"

# Temperature: cyan is cool, blue is warm, rose is critical.
theme[temp_start]="#34DACA"
theme[temp_mid]="#79BCF6"
theme[temp_end]="#F7ABD1"

# CPU: neutral until load is high, then rose. Keeps CPU numbers out of blue.
theme[cpu_start]="#D3D9DA"
theme[cpu_mid]="#D3D9DA"
theme[cpu_end]="#F7ABD1"

# Process list: blue when light, sky when busy, cyan when heavy.
# btop applies this to name, CPU, memory and thread columns.
theme[process_start]="#79BCF6"
theme[process_mid]="#ACEAFE"
theme[process_end]="#34DACA"

# Memory: green is capacity, blue is the middle, rose is pressure.
theme[free_start]="#F7ABD1"
theme[free_mid]="#79BCF6"
theme[free_end]="#89E28D"

# btop reuses this gradient for CPU/GPU watts and P-states.
# Keep it fg so power values read as text, not as a data category.
theme[cached_start]="#D3D9DA"
theme[cached_mid]="#D3D9DA"
theme[cached_end]="#D3D9DA"

theme[available_start]="#F7ABD1"
theme[available_mid]="#79BCF6"
theme[available_end]="#89E28D"

theme[used_start]="#89E28D"
theme[used_mid]="#79BCF6"
theme[used_end]="#F7ABD1"

# Network: download is cool, upload is warm-violet; clearly distinct.
theme[download_start]="#79BCF6"
theme[download_mid]="#ACEAFE"
theme[download_end]="#34DACA"

theme[upload_start]="#BFBAFA"
theme[upload_mid]="#F7ABD1"
theme[upload_end]="#F7ABD1"

# Process states
theme[proc_banner_bg]="#2A2F32"
theme[proc_banner_fg]="#D3D9DA"
theme[proc_pause_bg]="#2A2F32"
theme[proc_follow_bg]="#394B5B"
theme[followed_bg]="#394B5B"
theme[followed_fg]="#ACEAFE"
